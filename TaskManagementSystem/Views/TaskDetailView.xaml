<UserControl x:Class="TaskManagementSystem.Views.TaskDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100">

    <UserControl.Resources>
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="24"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="CommentLinkStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#2563EB"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#0F172A"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="32,24,32,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,24">
                <!-- Closing the detail belongs to the screen that opened it, so the
                     command is taken from the parent view's data context. -->
                <TextBlock Text="← Back to tasks" Foreground="#2563EB" FontWeight="Medium"
                           Cursor="Hand" Margin="0,0,0,16" HorizontalAlignment="Left">
                    <TextBlock.InputBindings>
                        <MouseBinding Gesture="LeftClick"
                                      Command="{Binding DataContext.CloseDetailCommand,
                                                RelativeSource={RelativeSource AncestorType=UserControl, AncestorLevel=2}}"/>
                    </TextBlock.InputBindings>
                </TextBlock>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding FormattedTaskId}" FontWeight="Bold" FontSize="12" Foreground="#2563EB" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding Task.Description}" FontSize="24" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,8" TextTrimming="CharacterEllipsis"/>

                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center"
                                     Fill="{Binding Task.Status, Converter={StaticResource StatusToBrush}}"/>
                            <TextBlock Text="{Binding Task.Status}" FontWeight="SemiBold" FontSize="13" Margin="0,0,12,0"
                                       Foreground="{Binding Task.Status, Converter={StaticResource StatusToBrush}}"/>
                            <TextBlock Text="{Binding Task.Type}" FontWeight="SemiBold" Foreground="#64748B" FontSize="13"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Content="Cancel" Command="{Binding CancelChangesCommand}"
                                Background="White" BorderBrush="#E2E8F0" BorderThickness="1" 
                                Foreground="#475569" FontWeight="SemiBold" Padding="16,8" Margin="0,0,12,0" Cursor="Hand"/>
                        <Button Content="Save changes" Command="{Binding SaveChangesCommand}"
                                Background="#2563EB" BorderThickness="0" 
                                Foreground="White" FontWeight="SemiBold" Padding="18,8" Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.6*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Task information" FontSize="18" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,20"/>
                        
                        <StackPanel Grid.Row="1" Margin="0,0,0,16">
                            <TextBlock Text="Description" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" MaxLength="2000"
                                     Height="70" TextWrapping="Wrap" AcceptsReturn="True"/>
                        </StackPanel>
                        
                        <Grid Grid.Row="2" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Status" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding SelectedStatus}" Padding="10,8"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Type" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox ItemsSource="{Binding Types}" SelectedItem="{Binding SelectedType}" Padding="10,8"/>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="3" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Assigned To" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}" DisplayMemberPath="Name" Padding="10,8"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Required By Date" Style="{StaticResource FieldLabelStyle}"/>
                                <DatePicker SelectedDate="{Binding RequiredByDate}" Padding="8,6"/>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="4" Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Next Action Date" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding NextActionDate, Mode=OneWay, StringFormat='{}{0:yyyy-MM-dd}', TargetNullValue='No reminders'}" 
                                         IsReadOnly="True" Background="#F1F5F9" Foreground="#64748B"/>
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="5" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                            <UniformGrid Columns="3">
                                <StackPanel>
                                    <TextBlock Text="Created" Foreground="#64748B" FontSize="12"/>
                                    <TextBlock Text="{Binding Task.CreatedAt, StringFormat='{}{0:MMM dd, yyyy}'}" FontWeight="Bold" FontSize="14" Foreground="#0F172A" Margin="0,4,0,0"/>
                                </StackPanel>

                                <StackPanel>
                                    <TextBlock Text="Task ID" Foreground="#64748B" FontSize="12"/>
                                    <TextBlock Text="{Binding FormattedTaskId}" FontWeight="Bold" FontSize="14" Foreground="#0F172A" Margin="0,4,0,0"/>
                                </StackPanel>

                                <StackPanel>
                                    <TextBlock Text="Comments" Foreground="#64748B" FontSize="12"/>
                                    <TextBlock Text="{Binding Comments.Count}" FontWeight="Bold" FontSize="14" Foreground="#0F172A" Margin="0,4,0,0"/>
                                </StackPanel>
                            </UniformGrid>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="Comments" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                            <Border Background="#F1F5F9" CornerRadius="10" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Comments.Count}" FontSize="12" FontWeight="Bold" Foreground="#475569"/>
                            </Border>
                        </StackPanel>

                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Comments}" Margin="0,0,0,16">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Type}" FontWeight="Bold" Foreground="#0F172A" FontSize="13"/>
                                                <TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Foreground="#94A3B8" FontSize="11" Margin="8,1,0,0"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Text}" Foreground="#334155" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0"/>

                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                <Button Content="Edit"
                                                        Style="{StaticResource CommentLinkStyle}"
                                                        Command="{Binding DataContext.BeginEditCommentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="Delete"
                                                        Style="{StaticResource CommentLinkStyle}"
                                                        Foreground="#DC2626"
                                                        Command="{Binding DataContext.DeleteCommentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Grid.Row="2">
                            <TextBox Text="{Binding NewCommentText, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="3000"
                                     Height="60" TextWrapping="Wrap" AcceptsReturn="True"
                                     Padding="8" Margin="0,0,0,8"/>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Comment type" Style="{StaticResource FieldLabelStyle}"/>
                                    <ComboBox ItemsSource="{Binding CommentTypes}"
                                              SelectedItem="{Binding NewCommentType}" Padding="8,6"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Reminder date" Style="{StaticResource FieldLabelStyle}"/>
                                    <DatePicker SelectedDate="{Binding NewCommentReminder}" Padding="6,4"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Orientation="Horizontal">
                                <Button Content="{Binding CommentSubmitLabel}" Command="{Binding SaveCommentCommand}"
                                        Background="White" BorderBrush="#CBD5E1" BorderThickness="1"
                                        Foreground="#334155" FontWeight="SemiBold" Padding="12,6" Cursor="Hand"/>
                                <Button Content="Cancel edit" Command="{Binding CancelCommentEditCommand}"
                                        Visibility="{Binding IsEditingComment, Converter={StaticResource BoolToVisibility}}"
                                        Background="Transparent" BorderThickness="0"
                                        Foreground="#64748B" FontWeight="SemiBold" Padding="12,6" Cursor="Hand"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
