<Window x:Class="TaskManagementSystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TaskManagementSystem"
        mc:Ignorable="d"
        Title="MainWindow" Height="900" Width="1440">
    <Window.Resources>
        <Style TargetType="TabItem" x:Key="SidebarTabItemStyle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="8" Margin="{TemplateBinding Margin}">
                            <ContentPresenter x:Name="ContentSite"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Stretch"
                                          ContentSource="Header"
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#EDF1FC"/>
                                <Setter Property="Foreground" Value="#2955CA"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Border" Property="Background" Value="#F9FAFB"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabControl" x:Key="SidebarTabControlStyle">
            <Setter Property="Background" Value="#F8F9FA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical"/>
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid Background="White">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0" Background="White">
                                <StackPanel Margin="16,24,16,0">

                                    <StackPanel Orientation="Horizontal" Margin="8,0,0,32">
                                        <TextBlock Text="Task Management" FontSize="18" FontWeight="Bold" Foreground="#111827" 
                                               VerticalAlignment="Center" Margin="12,0,0,0" FontFamily="Segoe UI"/>
                                    </StackPanel>
                                    <ItemsPresenter/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="{TemplateBinding Background}">
                                <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" Margin="24"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <TabControl Style="{StaticResource SidebarTabControlStyle}" FontFamily="Segoe UI" SelectedIndex="0">

        <TabItem Style="{StaticResource SidebarTabItemStyle}">
            <TabItem.Header>
                <Grid Width="200">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Path Grid.Column="0" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Left"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" 
                      Data="M19,3H14.82C14.4,1.84 13.3,1 12,1C10.7,1 9.6,1.84 9.18,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5A2,2 0 0,0 19,3M12,3A1,1 0 0,1 13,4A1,1 0 0,1 12,5A1,1 0 0,1 11,4A1,1 0 0,1 12,3M7,7H17V9H7V7M7,11H17V13H7V11M7,15H14V17H7V15Z"/>

                    <TextBlock Grid.Column="1" Text="All Tasks" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="2" Text="0" FontWeight="Bold" FontSize="12" Foreground="#8B95A5" VerticalAlignment="Center" Margin="0,0,8,0"/>
                </Grid>
            </TabItem.Header>
            
            <Grid>
                <TextBlock Text="All Tasks in table format here" FontSize="24" Foreground="#333" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </TabItem>
        
        <TabItem Style="{StaticResource SidebarTabItemStyle}">
            <TabItem.Header>
                <Grid Width="200">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Path Grid.Column="0" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Left"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" 
                      Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"/>

                    <TextBlock Grid.Column="1" Text="Search" FontSize="14" VerticalAlignment="Center"/>
                </Grid>
            </TabItem.Header>
            <Grid>
                <TextBlock Text="Search Engine for Comments" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </TabItem>

        <TabItem Style="{StaticResource SidebarTabItemStyle}">
            <TabItem.Header>
                <Grid Width="200">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Path Grid.Column="0" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Left"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" 
                      Data="M3,13H11V21H3V13M3,3H11V11H3V3M13,13H21V21H13V13M13,3H21V11H13V3M5,5V9H9V5H5M15,5V9H19V5H15M5,15V19H9V15H5M15,15V19H19V15H15Z"/>

                    <TextBlock Grid.Column="1" Text="Dashboard" FontSize="14" VerticalAlignment="Center"/>
                </Grid>
            </TabItem.Header>
            <Grid>

            </Grid>
        </TabItem>
    </TabControl>
</Window>
