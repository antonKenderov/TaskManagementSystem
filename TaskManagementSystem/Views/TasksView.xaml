<UserControl x:Class="TaskManagementSystem.Views.TasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TaskManagementSystem.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Loaded="OnLoaded">
    <Grid Background="#F3F4F6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.Resources>
            <Style x:Key="PrimaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#1F2937"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Padding" Value="16,8"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="FilterPlaceholderStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#6B7280"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="10,0,0,0"/>
                <Setter Property="IsHitTestVisible" Value="False"/>
            </Style>

            <Style TargetType="DataGrid">
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="#E5E7EB"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="RowBackground" Value="White"/>
                <Setter Property="AlternatingRowBackground" Value="#F9FAFB"/>
                <Setter Property="HeadersVisibility" Value="Column"/>
                <Setter Property="GridLinesVisibility" Value="Horizontal"/>
                <Setter Property="HorizontalGridLinesBrush" Value="#F3F4F6"/>
                <Setter Property="AutoGenerateColumns" Value="False"/>
                <Setter Property="CanUserAddRows" Value="False"/>
                <Setter Property="RowHeight" Value="40"/>
            </Style>

            <Style TargetType="DataGridRow">
                <!-- The whole row opens the task, so it should read as clickable.
                     The click is handled on button-up, by which point the DataGrid
                     has already moved the selection to this row. -->
                <Setter Property="Cursor" Value="Hand"/>
                <EventSetter Event="PreviewMouseLeftButtonUp" Handler="OnRowClick"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#EEF2F7"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#E4EAF4"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="White"/>
                <Setter Property="Foreground" Value="#6B7280"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Padding" Value="12,12"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="BorderBrush" Value="#E5E7EB"/>
            </Style>

            <Style TargetType="DataGridCell">
                <Setter Property="Padding" Value="12,0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridCell">
                            <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>

        <Grid Grid.Row="0" Margin="24,24,24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="All Tasks" FontSize="24" FontWeight="Bold" Foreground="#111827" VerticalAlignment="Center"/>

            <Button Command="{Binding OpenPopupCommand}" Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" Fill="White" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0"/>
                    <TextBlock Text="New Task" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <Border Grid.Row="1" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4" Margin="24,0,24,16" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="FILTER BY:" FontWeight="Bold" FontSize="11" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="0,0,16,0"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Status" Foreground="#6B7280" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox ItemsSource="{Binding StatusFilterOptions}"
                              DisplayMemberPath="Label"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding FilterStatus}"
                              MinWidth="120" Margin="0,0,20,0" Padding="8,4"/>

                    <TextBlock Text="Type" Foreground="#6B7280" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox ItemsSource="{Binding TypeFilterOptions}"
                              DisplayMemberPath="Label"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding FilterType}"
                              MinWidth="140" Margin="0,0,20,0" Padding="8,4"/>

                    <TextBlock Text="Assigned" Foreground="#6B7280" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox ItemsSource="{Binding UserFilterOptions}"
                              DisplayMemberPath="Label"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding FilterUserId}"
                              MinWidth="140" Margin="0,0,20,0" Padding="8,4"/>
                </StackPanel>

                <Button Grid.Column="2" Content="Clear filters" Command="{Binding ClearFiltersCommand}"
                        Background="Transparent" BorderThickness="0" Foreground="#2563EB"
                        FontSize="12" FontWeight="SemiBold" Cursor="Hand"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVisibility}}"/>
            </Grid>
        </Border>

        <DataGrid Grid.Row="2" Margin="24,0,24,0"
                  ItemsSource="{Binding Tasks}"
                  SelectedItem="{Binding SelectedTask}"
                  IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="CREATED ↓" Binding="{Binding CreatedAt, StringFormat=yyyy-MM-dd}" Width="120"/>
                <DataGridTextColumn Header="REQUIRED BY" Binding="{Binding RequiredBy, StringFormat=yyyy-MM-dd}" Width="120"/>
                <DataGridTextColumn Header="DESCRIPTION" Binding="{Binding Description}" Width="*"/>

                <DataGridTemplateColumn Header="STATUS" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="#E0F2FE" CornerRadius="10" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="Bold" Foreground="#0284C7"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="TYPE" Binding="{Binding Type}" Width="140" Foreground="#6B7280"/>
                <DataGridTextColumn Header="ASSIGNED TO" Binding="{Binding AssignedToName}" Width="150"/>
                <DataGridTextColumn Header="NEXT ACTION" Binding="{Binding NextActionDate, StringFormat=yyyy-MM-dd}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="3" Margin="24,16,24,24">
            <TextBlock Text="{Binding Tasks.Count, StringFormat=Showing {0} tasks}" Foreground="#6B7280" VerticalAlignment="Center"/>
        </Grid>

        <!-- Task detail. Opaque and spanning every row, so it covers the list while
             a task is open. The wrapper carries the visibility because the control
             itself is bound to the detail view model, not to this one. -->
        <Border Grid.Row="0" Grid.RowSpan="4" Background="#F3F4F6"
                Visibility="{Binding IsDetailsVisible, Converter={StaticResource BoolToVisibility}}">
            <local:TaskDetailView DataContext="{Binding TaskDetail}"/>
        </Border>

        <Grid Grid.Row="0" Grid.RowSpan="4"
              Background="#80000000"
              Visibility="{Binding IsPopupOpen, Converter={StaticResource BoolToVisibility}}">

            <Border Width="680" Background="White" CornerRadius="8"
                    VerticalAlignment="Center" HorizontalAlignment="Center">

                <Border.Effect>
                    <DropShadowEffect Color="Black" Opacity="0.15" BlurRadius="20" ShadowDepth="4"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#2C364C" CornerRadius="8,8,0,0" Padding="20,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Path Grid.Column="0" Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20M12.9,14.5L15.8,11.6L14.4,10.2L11.5,13.1L10.1,11.7L8.7,13.1L11.5,16L12.9,14.5Z"
                                  Fill="#94A3B8" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"/>

                            <TextBlock Grid.Column="1" Text="New Task" Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>

                            <Button Grid.Column="2" Command="{Binding ClosePopupCommand}"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand">
                                <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                                      Fill="#94A3B8" Width="14" Height="14" Stretch="Uniform"/>
                            </Button>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="1" Margin="24">

                        <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4" Padding="16,12" Margin="0,0,0,20">
                            <Grid>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Path Data="M12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22C6.47,22 2,17.5 2,12A10,10 0 0,1 12,2M12.5,7V12.25L17,14.92L16.25,16.15L11,13V7H12.5Z"
                                          Fill="#9CA3AF" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0"/>
                                    <TextBlock Foreground="#6B7280" VerticalAlignment="Center">
                                        <Run Text="Created Date: "/>
                                        <Run Text="{Binding CurrentTime, Mode=OneWay, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" Foreground="#374151"/>
                                    </TextBlock>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" Fill="#2563EB" Margin="0,0,8,0"/>
                                    <TextBlock Text="Status: Draft" Foreground="#6B7280" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Margin="0,0,0,8">
                            <TextBlock FontWeight="SemiBold" Foreground="#4B5563">
                                <Run Text="Description "/>
                                <Run Text="*" Foreground="#EF4444"/>
                            </TextBlock>
                            <TextBlock Text="{Binding NewTaskDescription.Length, FallbackValue=0, StringFormat={}{0} / 2000}"
                                       Foreground="#9CA3AF" HorizontalAlignment="Right" FontSize="11" VerticalAlignment="Bottom"/>
                        </Grid>
                        <TextBox Text="{Binding NewTaskDescription, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="2000"
                                 Height="80" TextWrapping="Wrap" AcceptsReturn="True"
                                 BorderBrush="#D1D5DB" BorderThickness="1" Padding="10" Foreground="#374151"
                                 Margin="0,0,0,20"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="20"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" FontWeight="SemiBold" Foreground="#4B5563" Margin="0,0,0,8">
                                <Run Text="Required By Date "/><Run Text="*" Foreground="#EF4444"/>
                            </TextBlock>
                            <DatePicker SelectedDate="{Binding NewTaskRequiredBy}"
                                        Grid.Row="1" Grid.Column="0" BorderBrush="#D1D5DB" Padding="4" Foreground="#374151"/>

                            <TextBlock Grid.Row="0" Grid.Column="2" FontWeight="SemiBold" Foreground="#4B5563" Margin="0,0,0,8">
                                <Run Text="Type "/><Run Text="*" Foreground="#EF4444"/>
                            </TextBlock>
                            <ComboBox ItemsSource="{Binding Types}" SelectedItem="{Binding SelectedType}" Grid.Row="1" Grid.Column="2" BorderBrush="#D1D5DB" Padding="10,6" Foreground="#374151"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" FontWeight="SemiBold" Foreground="#4B5563" Margin="0,0,0,8">
                                <Run Text="Initial Status "/><Run Text="*" Foreground="#EF4444"/>
                            </TextBlock>
                            <ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding SelectedStatus}" Grid.Row="4" Grid.Column="0" BorderBrush="#D1D5DB" Padding="10,6" Foreground="#374151"/>

                            <TextBlock Grid.Row="3" Grid.Column="2" FontWeight="SemiBold" Foreground="#4B5563" Margin="0,0,0,8">
                                <Run Text="Assigned To "/><Run Text="*" Foreground="#EF4444"/>
                            </TextBlock>
                            <ComboBox ItemsSource="{Binding Users}"
                                      SelectedItem="{Binding SelectedUser}"
                                      DisplayMemberPath="Name"
                                      Grid.Row="4" Grid.Column="2" BorderBrush="#D1D5DB" Padding="10,6" Foreground="#374151"/>
                        </Grid>
                    </StackPanel>

                    <Border Grid.Row="2" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0"
                            CornerRadius="0,0,8,8" Padding="20,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Validation and save failures land here; hidden while empty. -->
                            <TextBlock Grid.Column="0" Text="{Binding ErrorMessage}" Foreground="#B91C1C"
                                       TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Cancel" Command="{Binding ClosePopupCommand}"
                                    Background="White" BorderBrush="#D1D5DB" BorderThickness="1"
                                    Foreground="#374151" FontWeight="SemiBold" Padding="16,8" Cursor="Hand" Margin="0,0,12,0"/>

                            <Button Command="{Binding CreateTaskCommand}"
                                    Background="#2C364C" BorderThickness="0" Foreground="White" FontWeight="SemiBold"
                                    Padding="16,8" Cursor="Hand">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M17,13H13V17H11V13H7V11H11V7H13V11H17M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z"
                                          Fill="White" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Create Task" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
